/-!
# Axiom audit

Run with `lake env lean scripts/Audit.lean` after `lake build` and
`lake build Phylogenetics PhyloNetwork` (CI builds them). It checks that every declaration of the
library `TreeOfBlobs` and of the libraries `PhyloNetwork` and `Phylogenetics` that it requires, private
and auxiliary ones included, depends only on Lean's standard axioms `propext`, `Classical.choice` and
`Quot.sound` (a `sorry` would show up as the axiom `sorryAx`), and lists the axioms of the main
theorems. Declarations in Mathlib's namespaces are covered
too: the check goes through modules, not namespaces.
-/

open Lean Elab Command

namespace TreeOfBlobsAudit

/-- The main theorems of the library, with a short label. -/
meta def mainResults : List (String × Name) :=
  [("A search with low-points finds the bridges", ``Phylogenetics.BridgeDFS.isBridge_iff),
   ("The search takes as many steps as the vertices and twice the arcs", ``Phylogenetics.BridgeDFS.count_eq),
   ("Binary lifting answers lowest common ancestor queries", ``Phylogenetics.LCA.liftLCA_spec),
   ("Attaching subtrees at a multifurcation gives an unrooted tree",
    ``Phylogenetics.attachSubtrees_isUnrootedTree),
   ("No anomalous quartets at rho = 1", ``Phylogenetics.RootedNetwork.nmscCF_lt_rho_one_of_displays),
   ("The number of internal edges of a binary tree", ``TOBQMC.card_internalSides)]

/-- Lean's standard axioms. -/
meta def standardAxioms : List Name := [``propext, ``Classical.choice, ``Quot.sound]

/-- The libraries that the audit checks, by the root of their modules. -/
meta def isLibraryModule (m : Name) : Bool :=
  [`TreeOfBlobs, `PhyloNetwork, `Phylogenetics].any (·.isPrefixOf m)

elab "#audit_hub" : command => do
  let env ← getEnv
  let mut bad : Array Name := #[]
  let mut rows : Array String := #["| Result | Lean | Axioms |", "| --- | --- | --- |"]
  for (label, n) in mainResults do
    let axs ← liftCoreM <| collectAxioms n
    if axs.any (!standardAxioms.contains ·) then bad := bad.push n
    rows := rows.push s!"| {label} | `{n}` | {", ".intercalate (axs.toList.map toString)} |"
  let mut count := 0
  for m in env.header.moduleNames, d in env.header.moduleData do
    if isLibraryModule m then
      for c in d.constNames do
        count := count + 1
        let axs ← liftCoreM <| collectAxioms c
        if axs.any (!standardAxioms.contains ·) then bad := bad.push c
  logInfo ("\n".intercalate rows.toList ++
    s!"\n\nChecked {count} declarations of TreeOfBlobs, PhyloNetwork and Phylogenetics: " ++
    (if bad.isEmpty then "all use only the standard axioms." else "see the error."))
  unless bad.isEmpty do
    throwError m!"non-standard axioms used by: {bad}"

end TreeOfBlobsAudit

#audit_hub
